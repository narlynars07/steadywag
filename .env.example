# Copy this file to .env.local at the repo root. web/.env.local should be a symlink to it:
#   ln -s ../.env.local web/.env.local
# Every value below is a placeholder. Never commit real values.

# --- Sanity project (public identifiers, safe to share) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# --- The agent: model (required for the Ask page) ---
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=
# Optional. A free key from https://fdc.nal.usda.gov/api-key-signup for the USDA food lookup.
# Without it the shared demo key is used, which is rate-limited.
USDA_API_KEY=

# --- The agent: Sanity Context MCP endpoints and their read-only token ---
# Without these the agent falls back to direct dataset queries and labels each answer as such.
SANITY_ORGANIZATION_TOKEN=placeholder_context_viewer_token
SANITY_CONTEXT_CHART_URL=https://api.sanity.io/v1/context/organizations/your_org_id/mcp/your-chart-endpoint
SANITY_CONTEXT_KB_URL=https://api.sanity.io/v1/context/organizations/your_org_id/mcp/your-knowledge-endpoint

# --- Daily question limits (Upstash Redis keeps the counters; without Redis a per-process counter is used) ---
KV_REST_API_URL=https://placeholder.upstash.io
KV_REST_API_TOKEN=placeholder
CHAT_LIMIT_PER_VISITOR=40
CHAT_LIMIT_PER_DAY=500

# --- Scripts only (scripts/load_dataset.py). The web app never writes to the dataset. ---
SANITY_API_WRITE_TOKEN=placeholder_editor_token
